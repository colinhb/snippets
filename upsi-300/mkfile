MKSHELL=rc

RAWS_AGE=upsi-raws.zip.age
RAWS_ZIP=upsi-raws.zip

GORILLA_RAW=raws/data_exp_273904-vall_questionnaire-5mv9.csv
PROLIFIC_RAW=raws/prolific_demographic_export_6a2aa2d08f815b4e40405493.csv

JOIN_TSV=joined.tsv
STATS_TSV=stats.tsv

all:V: $STATS_TSV

$RAWS_ZIP: $RAWS_AGE
	age -d $RAWS_AGE > $target
	touch $target

$GORILLA_RAW $PROLIFIC_RAW: $RAWS_ZIP
	u unzip $RAWS_ZIP
	touch $GORILLA_RAW $PROLIFIC_RAW

# Build joined.tsv by inner-joining two raw exports:
#   - Prolific demographics (CSV, RFC-4180 quoted)
#   - Gorilla questionnaire  (TAB-delimited)
# Join key: Prolific "Submission id" == Gorilla "Participant External Session ID".
# Keep only approved / awaiting review Prolific submissions with a complete
# Gorilla questionnaire, bucket Age into an age_band column, and build upsi_score: 
# the humans_robots_pct A-Z letter + the rounded catastrophe score.
# Note: sqlite3 gives us a real CSV parser for the Prolific file
$JOIN_TSV: $PROLIFIC_RAW $GORILLA_RAW
	sqlite3 :memory: <<EOF
	.import --csv $PROLIFIC_RAW demo
	.mode tabs
	.import $GORILLA_RAW resp
	.headers on
	.output $target
	SELECT d."Submission id"              AS submission_id,
		d."U.s. political affiliation"    AS party_id,
		d.Age                             AS age,
		CASE
			WHEN CAST(d.Age AS INTEGER) BETWEEN 18 AND 34 THEN '18-34'
			WHEN CAST(d.Age AS INTEGER) BETWEEN 35 AND 49 THEN '35-49'
			WHEN CAST(d.Age AS INTEGER) BETWEEN 50 AND 64 THEN '50-64'
			WHEN CAST(d.Age AS INTEGER) >= 65             THEN '65+'
		END                            AS age_band,
		d.Sex                          AS sex,
		d."Ethnicity simplified"       AS ethnicity,
		r."P-axis object-2 Value"      AS ai_catastrophe_0_10,
		r."U-axis object-3 Value"      AS humans_robots_pct,
		char(65 + min(25, CAST(r."U-axis object-3 Value" AS INTEGER) * 26 / 100)) || CAST(round(r."P-axis object-2 Value") AS INTEGER) AS upsi_score
	FROM resp r
	JOIN demo d ON d."Submission id" = r."Participant External Session ID"
	WHERE r."Participant Status" = 'complete'             -- real questionnaire rows (drops question-text + END OF FILE footer; guards future incompletes)
		AND d."Status" IN ('APPROVED', 'AWAITING REVIEW') -- completed, non-withdrawn Prolific submissions (drops RETURNED/consent-revoked + TIMED-OUT)
	ORDER BY d."Submission id";
	EOF

# Marginal summary stats: n, mean, SD and SE of each measure per subgroup,
# one tidy row per group. Each dimension is one UNION line: tag every respondent
# dim=value, then a single GROUP BY rolls up all groups at once.
# SQLite has no stddev(), so the sample SD is built from sums, and SE = SD/sqrt(n):
#   SD = sqrt((sum(x*x) - sum(x)^2/n) / (n-1))   (*1.0 forces float division).
# mean_upsi_score = letter(mean pct) + round(mean catastrophe).
$STATS_TSV: $JOIN_TSV
	sqlite3 :memory: <<EOF
	.mode tabs
	.import $JOIN_TSV j
	.headers on
	.output $target
	WITH tall AS (
		SELECT 0 ord, 'total'             grp, ai_catastrophe_0_10 cat, humans_robots_pct pct FROM j
		UNION ALL SELECT 1, 'sex='  ||sex,       ai_catastrophe_0_10, humans_robots_pct FROM j
		UNION ALL SELECT 2, 'party='||party_id,  ai_catastrophe_0_10, humans_robots_pct FROM j
		UNION ALL SELECT 3, 'age='  ||age_band,  ai_catastrophe_0_10, humans_robots_pct FROM j
		UNION ALL SELECT 4, 'eth='  ||ethnicity, ai_catastrophe_0_10, humans_robots_pct FROM j
	)
	SELECT grp,
		count(*)          AS n,
		round(avg(cat),2) AS mean_ai_catastrophe,
		round(sqrt((sum(cat*cat) - sum(cat)*sum(cat)*1.0/count(*)) / (count(*)-1)) / sqrt(count(*)), 3) AS se_ai_catastrophe,
		round(sqrt((sum(cat*cat) - sum(cat)*sum(cat)*1.0/count(*)) / (count(*)-1)), 2) AS sd_ai_catastrophe,
		round(avg(pct),1) AS mean_humans_robots_pct,
		round(sqrt((sum(pct*pct) - sum(pct)*sum(pct)*1.0/count(*)) / (count(*)-1)) / sqrt(count(*)), 2) AS se_humans_robots_pct,
		round(sqrt((sum(pct*pct) - sum(pct)*sum(pct)*1.0/count(*)) / (count(*)-1)), 2) AS sd_humans_robots_pct,
		char(65 + min(25, CAST(avg(pct) * 26 / 100 AS INTEGER))) || CAST(round(avg(cat)) AS INTEGER) AS mean_upsi_score
	FROM tall
	GROUP BY grp
	ORDER BY min(ord), grp;
	EOF

clean:V:
	rm -f $RAWS_ZIP $GORILLA_RAW $PROLIFIC_RAW $JOIN_TSV $STATS_TSV
