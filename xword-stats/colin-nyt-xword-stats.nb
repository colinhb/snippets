(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["Colin\[CloseCurlyQuote]s NYT Crossword Stats", "Title",
 CellChangeTimes->{{3.989847342210046*^9, 
  3.989847350783836*^9}},ExpressionUUID->"9a12972b-c105-443b-bd64-\
5c1a2647be3c"],

Cell[TextData[{
 "First we set two constants: ",
 Cell[BoxData[
 "dataUrl"], "InlineCode",ExpressionUUID->
  "da6c46d8-00ac-4c6d-94ce-b0be5b23f135"],
 ", where the CSV lives (a file in our GitHub repo), and ",
 Cell[BoxData[
 "trendWindow"], "InlineCode",ExpressionUUID->
  "8cdce166-0f0c-4d0c-b8c7-082d6265ddd9"],
 ", the width of the rolling-median window we\[CloseCurlyQuote]ll smooth the \
trend with. Note: 90 days is roughly a quarter."
}], "Text",
 CellChangeTimes->{{3.989847371962201*^9, 3.98984738153894*^9}, {
  3.98984805111489*^9, 3.9898480756736937`*^9}, {3.989848254473851*^9, 
  3.9898482551196547`*^9}, {3.989849103628894*^9, 3.98984910473822*^9}, {
  3.989849203487377*^9, 
  3.989849208130556*^9}},ExpressionUUID->"337f279f-8fcd-43e5-893a-\
f8f15f0e31ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "dataUrl", 
   "=", "\"\<https://raw.githubusercontent.com/colinhb/snippets/refs/heads/\
main/xword-stats/data.csv\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trendWindow", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"90", ",", "\"\<Days\>\""}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, 
   3.9898470098570833`*^9, 3.9898479009114647`*^9, {3.9898481615953913`*^9, 
   3.989848163183506*^9}, {3.989848923102289*^9, 3.989848923337641*^9}},
 CellLabel->
  "In[207]:=",ExpressionUUID->"c4910250-44b2-4d69-a6e3-d65bee2e8653"],

Cell[TextData[{
 "Next we fix the weekday ordering, Monday through Sunday, and sample seven \
colors from ",
 ButtonBox["SolarColors",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/ColorData.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/ColorData.html"],
 " keyed to those days. Defining this once keeps the colors and legend \
consistent across every chart."
}], "Text",
 CellChangeTimes->{{3.989848206870373*^9, 3.9898482402951527`*^9}, {
  3.989849150964074*^9, 
  3.989849150964245*^9}},ExpressionUUID->"6c19e472-cd31-41c9-94aa-\
c2a023684e50"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dayOrder", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Monday\>\"", ",", "\"\<Tuesday\>\"", ",", "\"\<Wednesday\>\"",
      ",", "\"\<Thursday\>\"", ",", "\"\<Friday\>\"", ",", "\"\<Saturday\>\"",
      ",", "\"\<Sunday\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dayColors", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"dayOrder", "->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ColorData", "[", "\"\<SolarColors\>\"", "]"}], "/@", 
       RowBox[{"Subdivide", "[", "6", "]"}]}], ")"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, {
   3.9898470098570833`*^9, 3.989847026229048*^9}, {3.9898474309383507`*^9, 
   3.989847442756048*^9}, {3.98984818518222*^9, 3.989848199164303*^9}},
 CellLabel->
  "In[209]:=",ExpressionUUID->"f554be5f-62b7-4ae8-8f5a-5afcfaaba3e0"],

Cell[TextData[{
 "Now we pull the CSV down and tidy it. ",
 ButtonBox["SemanticImport",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/SemanticImport.html"], 
    None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/SemanticImport.html"],
 " infers each column\[CloseCurlyQuote]s type and parses the ISO date strings \
into ",
 Cell[BoxData[
 "DateObjects"], "InlineCode",ExpressionUUID->
  "124e53d7-2959-4b84-b531-2316b3124d72"],
 " for us. We keep only the puzzles that were actually solved and have a \
recorded time, rename the handful of fields we care about, convert seconds to \
minutes, and sort by date."
}], "Text",
 CellChangeTimes->{{3.9898470985824842`*^9, 3.989847103596582*^9}, {
   3.9898482620303793`*^9, 3.989848262396109*^9}, {3.989849174749802*^9, 
   3.989849174749979*^9}, 
   3.9898492217314863`*^9},ExpressionUUID->"2f09994f-56b3-490d-a7db-\
0afd1971cbf8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"raw", "=", 
    RowBox[{"SemanticImport", "[", "dataUrl", "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solved", "=", 
   RowBox[{
    RowBox[{"SortBy", "[", 
     RowBox[{"#date", "&"}], "]"}], "@", 
    RowBox[{"Normal", "@", 
     RowBox[{"raw", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"#\"solved\"", ",", 
            RowBox[{"True", "|", "\"\<True\>\""}]}], "]"}], "&&", 
          RowBox[{"NumberQ", "[", "#\"solving_seconds\"", "]"}]}], "&"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<date\>\"", "->", 
           RowBox[{"DateObject", "[", "#\"print_date\"", "]"}]}], ",", 
          RowBox[{"\"\<dayName\>\"", "->", "#\"day_of_week_name\""}], ",", 
          RowBox[{"\"\<minutes\>\"", "->", 
           RowBox[{"#\"solving_seconds\"", "/", "60."}]}]}], "|>"}], 
        "\[IndentingNewLine]", "&"}]}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, {
   3.9898470098570833`*^9, 3.989847047536952*^9}, 3.9898482661501913`*^9},
 CellLabel->
  "In[211]:=",ExpressionUUID->"9f7a662c-885e-49fa-91d9-95320a1d5aee"],

Cell[TextData[{
 "Now we use Tukey fences to remove outliers, computed separately for each \
weekday: anything below Q1 - 1.5 * IQR or above Q3 + 1.5 * IQR is dropped. \
Doing it per weekday matters because a slow Monday and a fast Saturday sit on \
completely different scales. More here: ",
 ButtonBox["Wikipedia",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Interquartile_range"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Interquartile_range"],
 ". "
}], "Text",
 CellChangeTimes->{{3.98984706446024*^9, 3.989847065188753*^9}, {
  3.9898482853365803`*^9, 3.9898483071941357`*^9}, {3.9898484126031513`*^9, 
  3.989848440329526*^9}},ExpressionUUID->"65039370-5987-4e13-a40e-\
f2d25060ff5c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"keepTukey", "[", "rows_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{
         RowBox[{"#minutes", "&"}], "/@", "rows"}]}], ",", "q1", ",", "q3", ",",
        "iqr"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q1", ",", "q3"}], "}"}], "=", 
       RowBox[{"Quantile", "[", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"3", "/", "4"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"iqr", "=", 
       RowBox[{"q3", "-", "q1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{"rows", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"q1", "-", 
           RowBox[{"1.5", " ", "iqr"}]}], "<=", "#minutes", "<=", 
          RowBox[{"q3", "+", 
           RowBox[{"1.5", " ", "iqr"}]}]}], "&"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"clean", "=", 
   RowBox[{"Catenate", "[", 
    RowBox[{"keepTukey", "/@", 
     RowBox[{"Values", "@", 
      RowBox[{"GroupBy", "[", 
       RowBox[{"solved", ",", 
        RowBox[{"#dayName", "&"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, {
   3.9898470098570833`*^9, 3.989847047536952*^9}, {3.98984710873076*^9, 
   3.989847114640477*^9}, {3.989848444196183*^9, 3.9898484458043013`*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"1274a66c-c1aa-436a-8b23-0338cffd1407"],

Cell["\<\
With the data cleaned, we bucket the rows into one list per weekday, in our \
Monday-to-Sunday order. This is a more convenient format to iterate over for \
charting.\
\>", "Text",
 CellChangeTimes->{{3.9898471723448772`*^9, 3.989847183026908*^9}, {
  3.9898484735742407`*^9, 
  3.98984848806212*^9}},ExpressionUUID->"0a425768-bd5d-438a-ba56-\
71411036b179"],

Cell[BoxData[
 RowBox[{
  RowBox[{"byDay", "=", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"GroupBy", "[", 
      RowBox[{"clean", ",", 
       RowBox[{"#dayName", "&"}]}], "]"}], ",", "dayOrder", ",", 
     RowBox[{"{", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, {
   3.9898470098570833`*^9, 3.989847047536952*^9}, {3.98984710873076*^9, 
   3.989847114640477*^9}, 3.989847189721033*^9, {3.98984743579676*^9, 
   3.989847436559911*^9}, 3.9898481832041483`*^9, 3.9898484908770533`*^9},
 CellLabel->
  "In[215]:=",ExpressionUUID->"bb0addd5-8b5b-48d3-ac05-d8f8d81f2e49"],

Cell[TextData[{
 "Here we assemble the trend chart. ",
 Cell[BoxData[
 "scatter"], "InlineCode",ExpressionUUID->
  "ea874655-fecd-4376-afad-f3ada4c5ba43"],
 " is the raw points per day; ",
 Cell[BoxData[
 "trend"], "InlineCode",ExpressionUUID->
  "27f4bba0-5f6a-4689-9fc8-07ae5af89e72"],
 " turns each weekday into a ",
 ButtonBox["TimeSeries",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/TimeSeries.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/TimeSeries.html"],
 " and runs a 90-day rolling median over it with ",
 ButtonBox["MovingMap",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/MovingMap.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/MovingMap.html"],
 ". We then overlay the faint dots and the median lines, color them by \
weekday, anchor the y-axis at zero, and attach a legend."
}], "Text",
 CellChangeTimes->{{3.989847254267579*^9, 3.989847260302307*^9}, {
  3.989848528634597*^9, 3.989848530396933*^9}, {3.989848573385261*^9, 
  3.98984859371513*^9}, {3.989849255615858*^9, 
  3.989849259289176*^9}},ExpressionUUID->"8d2b33d0-5d26-46ba-9081-\
dc526e5535a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"scatter", "=", 
   RowBox[{"Map", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"rows", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#date", ",", "#minutes"}], "}"}], "&"}], "/@", "rows"}]}], 
      "]"}], ",", "\[IndentingNewLine]", "byDay"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trend", "=", 
   RowBox[{"Map", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"rows", ",", 
       RowBox[{"MovingMap", "[", 
        RowBox[{"Median", ",", 
         RowBox[{"TimeSeries", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#date", ",", "#minutes"}], "}"}], "&"}], "/@", "rows"}],
           "]"}], ",", "trendWindow"}], "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "byDay"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"trendChart", "=", 
   RowBox[{"Legended", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"DateListPlot", "[", "\[IndentingNewLine]", 
        RowBox[{"scatter", ",", "\[IndentingNewLine]", 
         RowBox[{"Joined", "->", "False"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Opacity", "[", "0.35", "]"}], ",", 
               RowBox[{"AbsolutePointSize", "[", "2.5", "]"}]}], "]"}], "&"}],
             "/@", 
            RowBox[{"Values", "[", "dayColors", "]"}]}], ")"}]}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"DateListPlot", "[", "\[IndentingNewLine]", 
        RowBox[{"trend", ",", "\[IndentingNewLine]", 
         RowBox[{"Joined", "->", "True"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"#", ",", 
               RowBox[{"AbsoluteThickness", "[", "1.8", "]"}]}], "]"}], "&"}],
             "/@", 
            RowBox[{"Values", "[", "dayColors", "]"}]}], ")"}]}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"y", "-", 
          RowBox[{"baseline", " ", "at", " ", "0"}]}], ",", 
         RowBox[{"like", " ", 
          RowBox[{"zero", ":", "true"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Date\>\"", ",", "\"\<Solve time (minutes)\>\""}], 
         "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "->", "760"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "1.7"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SwatchLegend", "[", 
      RowBox[{
       RowBox[{"Values", "[", "dayColors", "]"}], ",", "dayOrder"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, {
   3.9898470098570833`*^9, 3.989847047536952*^9}, {3.98984710873076*^9, 
   3.989847114640477*^9}, 3.989847189721033*^9, 3.989847267368969*^9, {
   3.989847456214492*^9, 3.989847458509918*^9}, 3.989848194739417*^9, {
   3.989848603042047*^9, 3.9898488592451143`*^9}, {3.989848951661907*^9, 
   3.989848953229794*^9}},ExpressionUUID->"774e5d8e-0db7-42df-8fb3-\
967e5a118150"],

Cell["\<\
Finally we render it. (Column wraps a single chart for now; it\
\[CloseCurlyQuote]s where we\[CloseCurlyQuote]d stack additional views in.) \
\>", "Text",
 CellChangeTimes->{{3.9898472783240137`*^9, 3.989847278886222*^9}, {
  3.9898490295622168`*^9, 
  3.989849045116312*^9}},ExpressionUUID->"d2143db8-fd12-40ce-b9b7-\
f334c5eb5311"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", "trendChart", "}"}], "]"}]], "Input",
 CellChangeTimes->{
  3.989840924747911*^9, {3.989840960073402*^9, 3.9898410309474907`*^9}, {
   3.9898410906615*^9, 3.989841149038272*^9}, {3.989841191782831*^9, 
   3.9898411962845297`*^9}, 3.9898414707572803`*^9, {3.989841604682457*^9, 
   3.989841643050375*^9}, {3.989841682267762*^9, 3.989841811911798*^9}, {
   3.9898470098570833`*^9, 3.989847047536952*^9}, {3.98984710873076*^9, 
   3.989847114640477*^9}, 3.989847189721033*^9, 3.989847267368969*^9, 
   3.989848973871571*^9},ExpressionUUID->"443255ce-b15e-4318-9c72-\
e7369b9f2948"],

